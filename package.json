{
  "name": "monte-gilching",
  "description": "Montessori Website Gilching",
  "version": "1.0.0",
  "license": "MIT",
  "author": "behboud kalantary",
  "scripts": {
    "dev": "astro dev --host localhost --port 4173",
    "build": "astro check && astro build",
    "preview": "astro preview --host localhost --port 4173",
    "seed:generate": "node scripts/create-emdash-seed.mjs",
    "seed:local": "emdash seed seed/seed.json --database ./data.db --uploads-dir ./uploads",
    "migrate:content-model": "node scripts/migrate-content-model.mjs",
    "test:content-model": "node --test tests/content-model.test.mjs",
    "test:ui": "playwright test tests/ui/admin.spec.ts tests/ui/interaction.spec.ts tests/ui/privacy-regression.spec.ts tests/ui/public-links.spec.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.63.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.8",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "emdash": "1.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
