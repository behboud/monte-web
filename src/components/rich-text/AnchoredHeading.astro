---
import type { BlockProps } from "astro-portabletext/types";

type AnchoredNode = BlockProps["node"] & { textAlign?: string; _anchorId?: string };
type Props = Omit<BlockProps, "node"> & { node: AnchoredNode };

const props = Astro.props as Props;
const { node, index: _index, isInline: _isInline, ...attrs } = props;
const alignClass = node.textAlign === "center"
  ? "has-text-align-center"
  : node.textAlign === "right"
    ? "has-text-align-right"
    : node.textAlign === "justify"
      ? "has-text-align-justify"
      : undefined;
const anchorId = typeof node._anchorId === "string" ? node._anchorId : undefined;
const style = node.style;
---

{
  style === "h1" ? (
    <h1 id={anchorId} class={alignClass} {...attrs}><slot /></h1>
  ) : style === "h2" ? (
    <h2 id={anchorId} class={alignClass} {...attrs}><slot /></h2>
  ) : style === "h3" ? (
    <h3 id={anchorId} class={alignClass} {...attrs}><slot /></h3>
  ) : style === "h4" ? (
    <h4 id={anchorId} class={alignClass} {...attrs}><slot /></h4>
  ) : style === "h5" ? (
    <h5 id={anchorId} class={alignClass} {...attrs}><slot /></h5>
  ) : (
    <h6 id={anchorId} class={alignClass} {...attrs}><slot /></h6>
  )
}

<style>
  .has-text-align-center { text-align: center; }
  .has-text-align-right { text-align: right; }
  .has-text-align-justify { text-align: justify; }
</style>
