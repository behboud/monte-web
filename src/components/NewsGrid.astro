---
import { formatNewsDate, type NewsPost } from "../lib/site-content";
import { sitePath } from "../lib/site-path";

interface Props {
  posts: NewsPost[];
  limit?: number;
  itemClass?: string;
}

const { posts, limit, itemClass } = Astro.props;
const visiblePosts = typeof limit === "number" ? posts.slice(0, limit) : posts;
---

<div class="flex flex-row flex-wrap">
  {visiblePosts.map((post) => (
    <div class={itemClass ?? "basis-1/2 lg:basis-1/3 xl:basis-1/4 mb-2 pr-2"}>
      <div class="card card-body flex h-full flex-col justify-between">
        <div class="container">
          <h3 class="card-title mb-2 text-monte">
            <a href={sitePath(`/aktuelles/${post.slug}/`)}>{post.data.title}</a>
          </h3>
          <ul class="mb-4">
            <li class="mr-4 inline-block">
              <i class="fa-regular fa-calendar"></i>{" "}
              {formatNewsDate(post.data.event_date)}
            </li>
            {post.data.terms.tag.length > 0 && (
              <li class="mr-4 inline-block">
                {post.data.terms.tag.map((tag) => (
                  <a class="btn btn-text mr-1" href={sitePath(`/tags/${tag.slug}/`)}>
                    <i class="fa fa-tag mr-1"></i>{" "}
                    {tag.label}
                  </a>
                ))}
              </li>
            )}
          </ul>
          <p class="mb-6">{post.data.summary}</p>
        </div>
        <a class="btn btn-default w-fit" href={sitePath(`/aktuelles/${post.slug}/`)}>
          Weiterlesen
        </a>
      </div>
    </div>
  ))}
</div>
